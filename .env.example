# ─── LLM ─────────────────────────────────────────────────────────────────────
# Provider: "gemini", "groq", or "local"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=mistral
LLM_TIMEOUT=90
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Vector DB ────────────────────────────────────────────────────────────────
CHROMA_DIR=./chroma_db

# ─── RAG ──────────────────────────────────────────────────────────────────────
TOP_K=20
RERANK_TOP_K=8
CHUNK_SIZE=400
CHUNK_OVERLAP=80
MIN_CHUNK_CHARS=50
SCORE_THRESHOLD=0.0

# ─── Advanced retrieval ────────────────────────────────────────────────────────
USE_HYDE=true
# Set USE_RERANK=true and provide COHERE_API_KEY to enable reranking
USE_RERANK=false
COHERE_API_KEY=

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_MAX_SIZE=200

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ─── Ingestion ────────────────────────────────────────────────────────────────
REPO_TEMP_DIR=./tmp_repos
MAX_FILE_KB=500
# Optional: set your GitHub token for private repos
GITHUB_TOKEN=

# ─── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
